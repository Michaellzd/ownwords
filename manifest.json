{
  "manifest_version": 3,
  "name": "X Draft",
  "version": "0.1.0",
  "description": "Turn rough drafts into clear, natural English without leaving the conversation. Bring your own OpenRouter key.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel", "clipboardWrite"],
  "host_permissions": ["https://openrouter.ai/*"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": { "default_title": "Open X Draft" },
  "side_panel": { "default_path": "panel.html" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://openrouter.ai; base-uri 'none'"
  }
}
